# Copy to .env and fill in. .env is gitignored; this file is not.
# Load with:  set -a; source .env; set +a

# Address of the WiCAN Pro. Station mode gives it a DHCP address; in
# access-point mode it is 192.168.0.10.
MEATPI_HOST=192.168.0.10
MEATPI_PORT=35000

# BLE pairing passkey, shown in the dongle's web UI. The OS pairing dialog
# asks for this — it is never sent by the app, so it is only a convenience
# note to yourself.
MEATPI_BLE_PASSKEY=

# MeatHandler (the dongle pushes to it in AutoPID mode). The app uses this by
# default; set MEATPI_DIRECT=1 to talk to the dongle instead.
MEATHANDLER_URL=https://meathandler.ddns.net:8443
MEATHANDLER_USER=enoch
MEATHANDLER_PASS=
